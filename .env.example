# Copy to .env and fill in. .env is gitignored — never commit it.
# Every value here is optional; the setup degrades to lower rate limits or
# fewer databases rather than breaking.

# No model API key is needed anywhere. Every skill, /ingest included, runs
# inside Claude Code on the subscription you already have.

# ---------------------------------------------------------------------------
# Open citation APIs
# ---------------------------------------------------------------------------

# OpenAlex — https://openalex.org
# Works with no key at all. Supplying a contact email ("polite pool") gives you
# faster, more reliable service; a key is only needed for premium features.
OPENALEX_MAILTO=you@university.edu
OPENALEX_API_KEY=

# Semantic Scholar — https://www.semanticscholar.org/product/api
# Works unauthenticated at ~1 request/second. A free key raises the limit and
# is worth requesting if you plan long citation-chain sessions.
# Sent as the header:  x-api-key: <key>
SEMANTIC_SCHOLAR_API_KEY=

# Crossref — https://www.crossref.org/documentation/retrieve-metadata/rest-api/
# No key. An email address puts you in the polite pool.
CROSSREF_MAILTO=you@university.edu

# Unpaywall — https://unpaywall.org/products/api
# Finds legal open-access PDFs for a DOI. Email is the only credential.
UNPAYWALL_EMAIL=you@university.edu

# ---------------------------------------------------------------------------
# Library / institutional access
# ---------------------------------------------------------------------------
# Subscription databases (Scopus, Web of Science, EBSCO, JSTOR, ProQuest) sit
# behind an institutional login, so no API key reaches them. /research opens
# them in a real browser via the Playwright MCP server and pauses for you to
# log in by hand when a login screen appears. Your credentials are never read,
# transmitted, or stored by the agent — only the resulting page is read.
#
# LIBRARY_PROXY_SUFFIX is the string your library appends to a publisher host.
# Find it by opening any database through your library portal and looking at
# the URL bar. Examples:
#   Aarhus University   .ez.statsbiblioteket.dk
#   Many EZproxy sites  .ezproxy.<your-institution>.edu
# Leave blank if your institution uses IP-based or VPN access instead.
LIBRARY_PROXY_SUFFIX=
LIBRARY_PROXY_LOGIN_HINT=

# Optional: full URLs to the search forms you use most, already proxied.
# /research navigates straight to these instead of guessing.
DB_SCOPUS_URL=
DB_WEB_OF_SCIENCE_URL=
DB_EBSCO_URL=
DB_OTHER_URL=

# ---------------------------------------------------------------------------
# Elsevier / Scopus API (optional, institution-dependent)
# ---------------------------------------------------------------------------
# If your institution has an Elsevier API entitlement you can query Scopus
# directly instead of driving a browser. Request a key at https://dev.elsevier.com
# Note that entitlement usually still requires being on the institutional
# network or supplying an insttoken.
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=
